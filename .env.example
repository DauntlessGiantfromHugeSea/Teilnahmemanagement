# Postgres
DATABASE_URL="postgresql://user:pass@localhost:5432/teilnahmemanagement?schema=public"

# 32-byte hex key for AES-256-GCM field encryption (64 hex chars)
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=""

# JWT signing secret for session cookies
# Generate with: openssl rand -hex 48
SESSION_SECRET=""

# App
APP_NAME="FB-Akademie Teilnahmemanagement"
APP_URL="http://localhost:3000"

# Webhook (Wordpress / CF7 -> direkte Anmeldungen)
# Langer Zufallswert, mindestens 16 Zeichen. Erzeugen: openssl rand -hex 32
WEBHOOK_API_KEY=""

# --- SMTP / Mailing ---
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"          # true = SSL (Port 465), false = STARTTLS (Port 587)
SMTP_USER=""                # Postfach-Username (z.B. m07f3b68 oder noreply@domain.de)
SMTP_PASS=""                # Postfach-Passwort
MAIL_FROM="FB-Akademie <noreply@fluessigbodenakademie.de>"
MAIL_REPLY_TO=""            # optional - Antworten an diese Adresse
MAIL_ADMIN=""               # optional - Admin-Benachrichtigung (Komma-Liste moeglich)

# Microsoft / Entra ID Single-Sign-On (optional)
# Wenn alle drei gesetzt sind, erscheint auf der Login-Seite zusaetzlich der
# Button "Mit Microsoft anmelden". Bestehende User werden beim ersten Klick
# automatisch ueber die E-Mail-Adresse verknuepft (nur eigener Tenant erlaubt).
MS_TENANT_ID=""             # z.B. e47a6b12-0ae0-4db5-a6ee-ec4186b11bb0
MS_CLIENT_ID=""             # Application (client) ID aus dem Entra Admin Center
MS_CLIENT_SECRET=""         # Wert (nicht Secret-ID!) des Geheimnisses
