# Kopiere diese Datei nach .env (neben docker-compose.yml).
# Werte mit "CHANGE_ME" muessen ersetzt werden.

# --- Postgres ---
POSTGRES_USER=tm
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=teilnahmemanagement

# --- App-Secrets ---
# 32 Bytes = 64 hex chars. Generieren mit:  openssl rand -hex 32
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars
# 48+ Bytes. Generieren mit:  openssl rand -hex 48
SESSION_SECRET=CHANGE_ME_96_hex_chars

# --- App ---
APP_NAME=FB-Akademie Teilnahmemanagement
APP_URL=https://teilnahme.deine-domain.de

# --- Webhook (Wordpress / CF7 -> direkte Anmeldungen) ---
# Erzeugen: openssl rand -hex 32   (mindestens 16 Zeichen)
WEBHOOK_API_KEY=CHANGE_ME_64_hex_chars

# --- Cloudflare Turnstile (oeffentliches Anmeldeformular) ---
# Leer lassen, falls nicht genutzt - dann nur Honeypot-Spamschutz.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- SMTP / Mailing (Anmeldebestaetigungen + Admin-Notification) ---
# Beispiel All-Inkl/Kasserver:
#   SMTP_HOST=w020deb9.kasserver.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=m07f3b68               (oder noreply@fluessigbodenakademie.de)
#   SMTP_PASS=...                    (Postfach-Passwort - NICHT einchecken)
#   MAIL_FROM=FB-Akademie <noreply@fluessigbodenakademie.de>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_ADMIN=
# Optionen fuer das Mail-Layout
MAIL_LOGO_URL=
MAIL_BRAND_COLOR=#0f766e
MAIL_FOOTER_LINE=

# --- Iframe-Embedding (oeffentliche Anmeldeseiten) ---
# Leerzeichen- oder kommagetrennte Liste von Hosts (ohne https://, ohne Pfad).
# Subdomains werden automatisch mit erlaubt (z.B. app.fb-eng.de).
# Default, falls leer: "fb-eng.de fb-stage.de fi-fb.de"
IFRAME_HOSTS=fb-eng.de fb-stage.de fi-fb.de fb-akademie.de

# --- Initialer Admin (nur beim allerersten Start aktivieren) ---
RUN_SEED_ON_START=1
SEED_ADMIN_EMAIL=admin@fb-akademie.de
# Eigenes Passwort erzeugen, z.B.: openssl rand -base64 24
# Ohne Wert wird beim Seeding kein Admin angelegt.
SEED_ADMIN_PASSWORD=

# --- SMTP / Mailversand (z.B. kasserver.com) ---
SMTP_HOST=w020deb9.kasserver.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=m07f3b68
SMTP_PASS=CHANGE_ME_smtp_passwort
SMTP_FROM=FLÜSSIGBODEN AKADEMIE <noreply@fluessigbodenakademie.de>

# --- Webhook fuer Anmeldungen UND Newsletter (mind. 16 Zeichen) ---
# Generieren mit:  openssl rand -hex 24
WEBHOOK_API_KEY=CHANGE_ME_webhook_key

# --- Posteingang / Tickets ---
# Bearer-Token fuer /api/cron/mail-ingest und /api/cron/reminders.
# Erzeugen: openssl rand -hex 32
CRON_TOKEN=""
# Praefix der Ticket-Referenz (Default: FBA) -> FBA-7K2M9-4XQ1P
TICKET_REF_PREFIX="FBA"
# Microsoft-365-Postfaecher laufen ueber die Graph-API (Basic Auth ist dort
# abgeschaltet). Dafuer werden MS_TENANT_ID / MS_CLIENT_ID / MS_CLIENT_SECRET
# oben mitbenutzt - die App-Registrierung braucht zusaetzlich die
# ANWENDUNGSberechtigungen Mail.ReadWrite und Mail.Send mit Admin-Zustimmung.
# MS_TENANT_ID muss die konkrete Tenant-GUID sein, "common" geht hier nicht.
# Tenants, aus denen ein Microsoft-Konto beim ERSTEN Login automatisch mit
# einem vorhandenen lokalen Konto gleicher E-Mail-Adresse verknuepft werden
# darf. Leer lassen: dann gilt MS_TENANT_ID, sofern das eine Tenant-GUID ist.
# Bei MS_TENANT_ID="common" findet ohne diesen Eintrag keine automatische
# Verknuepfung statt - sonst koennte ein beliebiges Microsoft-Konto mit
# passender Adresse ein lokales Konto uebernehmen.
MS_LINK_TENANTS=""
# Postfaecher, fuer die die tenantweite App-Registrierung verwendet werden
# darf (Posteingang). Mail.ReadWrite gilt im Tenant fuer alle Postfaecher -
# diese Liste begrenzt, welche Adressen die Anwendung damit anfassen darf.
# Leer = kein Rueckfall; jedes Postfach braucht dann eigene Zugangsdaten.
MS_GRAPH_MAILBOXES="schulung@fb-akademie.de info@fb-akademie.de"

# --- Zeitzone ---
# Zeitzone des Containers (Anzeige von Zeitstempeln) und fachliche Zeitzone
# fuer Fristen. Sommer-/Winterzeit wird daraus automatisch abgeleitet, es ist
# keine manuelle Umstellung noetig.
TZ=Europe/Berlin
APP_TIMEZONE=Europe/Berlin
# Vorlauf der Erinnerungsmail in Stunden vor dem tatsaechlichen Beginn.
REMINDER_LEAD_HOURS=24

# --- Mailversand ueber Microsoft Graph ---
# "graph" | "smtp" | "auto" (Default auto). Bei graph entfaellt SMTP_* vollstaendig.
MAIL_TRANSPORT=graph
# Postfach, aus dem verschickt wird. Braucht die Anwendungsberechtigung
# Mail.Send in der App-Registrierung (MS_CLIENT_ID) samt Admin-Zustimmung.
MAIL_GRAPH_SENDER=info@fb-akademie.de
# Kopie in "Gesendete Elemente" des Postfachs ablegen.
MAIL_GRAPH_SAVE_SENT=true
