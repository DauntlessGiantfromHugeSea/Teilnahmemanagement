// Teilnahmemanagement - Datenmodell
// Sensible Felder (Name, E-Mail, Adresse, Telefon, Notizen) werden vor dem
// Schreiben in die DB AES-256-GCM verschluesselt (siehe src/lib/crypto.ts).
// Daher sind alle solchen Felder als String/Text deklariert und enthalten
// Base64-codierte Ciphertexte. Suche/Filter laeuft ueber zusaetzliche
// Blind-Index-Hashes (z. B. emailHash).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  EVENTMANAGER   // darf Veranstaltungen + Agenda + Event-Portal bearbeiten, keine Buchhaltung
  ACCOUNTING
  VIEWER
}

enum DayOption {
  DAY_1
  DAY_2
  BOTH
}

enum ParticipantStatus {
  REGISTERED
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum InvoiceStatus {
  OPEN
  ISSUED
  PAID
  CANCELLED
}

enum EventFormat {
  PRESENCE  // Praesenz-Schulung vor Ort
  WEBINAR   // Online-Webinar
}

enum NewsletterStatus {
  PENDING       // Double-Opt-In ausstehend (Bestaetigungsmail verschickt)
  SUBSCRIBED    // bestaetigt, erhaelt Newsletter
  UNSUBSCRIBED  // abgemeldet
  BOUNCED       // Zustellung dauerhaft fehlgeschlagen
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum EmailStatus {
  SENT
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(VIEWER)
  // 2FA
  totpSecret    String?   // verschluesselt
  totpEnabled   Boolean   @default(false)
  totpRequired  Boolean   @default(true)  // false = Login auch ohne 2FA erlaubt
  // Microsoft / Entra ID Single-Sign-On
  msOid         String?   @unique  // stabile MS Object-ID nach erstem Login
  msTenantId    String?   // MS Tenant-ID (Whitelist via MS_TENANT_ID)
  recoveryCodes String?   // verschluesselt, JSON-Array
  // 2FA per E-Mail (Code)
  emailCodeEnabled  Boolean   @default(false)
  loginCodeHash     String?
  loginCodeExpiresAt DateTime?
  // Einladung / Passwort-Reset (token-basiert)
  pwTokenHash     String?   // sha256-Hex des Token
  pwTokenExpiresAt DateTime?
  // Meta
  active        Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  eventGrants   EventAccess[]
  comments      Comment[]
  auditEntries  AuditLog[]
  createdEvents Event[]   @relation("EventCreatedBy")
  createdCerts  Certificate[] @relation("CertCreatedBy")
}

model Training {
  id          String   @id @default(cuid())
  title       String
  description String?
  // Preise in Cent, je Buchungsoption
  priceDay1   Int      @default(0)
  priceDay2   Int      @default(0)
  priceBoth   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events      Event[]

  // Defaults fuer die Zertifikatserstellung (JSON, siehe lib/certificates.ts)
  certDefaults String?
}

model Event {
  id          String      @id @default(cuid())
  externalId  String?     @unique // z.B. "#260603" aus Anmeldeformular - fuer CSV-Import-Dedup
  trainingId  String
  training    Training    @relation(fields: [trainingId], references: [id])
  title       String      // z. B. "Crashkurs Maerz 2026"
  format      EventFormat @default(PRESENCE)
  description String?     // optionale Kurzbeschreibung (unverschluesselt, intern)
  // Praesenz
  location    String?
  // Webinar
  meetingUrl  String?
  // Termin
  day1Date    DateTime?
  day2Date    DateTime?
  // Zusaetzliche Termine ab Tag 3 (JSON-Array von YYYY-MM-DD-Strings)
  extraDays   String?
  startTime   String?     // HH:MM
  endTime     String?     // HH:MM
  // Kapazitaet
  capacity    Int?
  // Customizing fuer die oeffentliche Anmeldeseite (alles optional)
  subtitle        String?   // kurzer Untertitel / Kicker
  longDescription String?   // ausfuehrliche Beschreibung (Plaintext, Zeilenumbrueche werden gerendert)
  agenda          String?   // Programmpunkte / Bullets, je Zeile ein Punkt
  heroImageUrl    String?   // Bild oben auf der Anmeldeseite (https-URL)
  logoUrl         String?   // optional ein eigenes Logo pro Event
  pageBlocks      String?   // JSON-Array von Inhalts-Bloecken fuer den Page-Builder
  // Optionaler Override fuer den Fliesstext der Teilnahmebescheinigung dieses Events.
  // Wenn leer, wird Training.certDefaults.tnBody verwendet.
  certTnBody      String?   // Plaintext, Absaetze durch Leerzeile (Tag 1 bzw. Eintagesseminar)
  // Bei 2-Tages-Schulungen ein separater Body fuer die zweite Bescheinigung.
  certTnBodyDay2  String?
  // Pro-Event-Override fuer den Feedback-Fragebogen (JSON-Array). Wenn leer,
  // gilt der globale Standard aus AppSetting 'feedbackQuestions'.
  feedbackQuestions String?
  // Status
  cancelled   Boolean     @default(false)
  // Interne Notizen (verschluesselt)
  notes       String?
  createdById String
  createdBy   User        @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  participants Participant[]
  grants       EventAccess[]
  feedbackInvites FeedbackInvite[]
  agendaItems EventAgendaItem[]
  portalBlocks EventPortalBlock[]
}

// Agenda-Eintrag fuer eine Schulung. Sortierung ueber 'position'; aktuell
// laufender Eintrag wird im Portal hervorgehoben.
model EventAgendaItem {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  day         Int      @default(1)        // 1 oder 2
  startTime   String                       // "09:00"
  endTime     String?                      // "10:30"
  title       String
  description String?                      // Mehrzeilig moeglich
  speaker     String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
}

// Freie Inhalts-Blocks fuer das oeffentliche Event-Portal (WLAN, Abendveranstaltung,
// Hinweise, ...). Der Admin entscheidet pro Event welche Blocks angelegt sind.
model EventPortalBlock {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  icon      String?                       // optionaler Icon-Key (wifi, food, info, contact, ...)
  title     String
  body      String                         // Plaintext, Absaetze durch Leerzeilen
  position  Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

// Pro-Event-Zugriff fuer User (zusaetzlich zur Rolle)
model EventAccess {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  canWrite  Boolean  @default(false)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Participant {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // PII - alle Base64-Ciphertexte
  firstName    String
  lastName     String
  email        String
  emailHash    String   // SHA-256 fuer Suche/Dedupe
  phone        String?
  company      String?
  street       String?
  zip          String?
  city         String?
  country      String?
  notes        String?

  dayOption    DayOption @default(BOTH)
  // Rabatt in Prozent (0-100), zwei Nachkommastellen via *100
  discountBps  Int       @default(0) // basis points: 1000 = 10.00%
  status       ParticipantStatus @default(REGISTERED)

  // Rechnungsanschrift (verschluesselt) - kann von der Teilnehmer-Anschrift abweichen
  billingCompany String?
  billingName    String?
  billingStreet  String?
  billingZipCity String?
  billingEmail   String?
  costCenter     String?

  // Buchhaltung
  invoiceStatus InvoiceStatus @default(OPEN)
  invoiceNumber String?
  invoiceIssuedAt DateTime?
  invoicePaidAt   DateTime?
  invoiceNotes    String? // verschluesselt

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments     Comment[]
  history      AuditLog[]
  certificates Certificate[]
  feedbackInvites FeedbackInvite[]

  @@index([emailHash])
  @@index([eventId])
}

enum CertificateType {
  ZERTIFIKAT          // mit Kompetenzfeldern (bestanden)
  TEILNAHMEBESCHEINIGUNG
}

enum CertificateStatus {
  DRAFT       // erzeugt, noch nicht freigegeben (nicht gueltig)
  RELEASED    // freigegeben, oeffentlich abrufbar, verschickbar
  REVOKED     // widerrufen
}

// Globale Konfiguration als simpler Key/Value-Store (JSON-Werte).
// Wird z.B. fuer die Kompetenzfeld-Texte verwendet, damit diese ohne Deploy
// angepasst werden koennen.
model AppSetting {
  key       String   @id
  value     String   // JSON
  updatedAt DateTime @updatedAt
}

model Certificate {
  id            String   @id @default(cuid())
  // menschenlesbare Nummer (z.B. 26-TN-LM-26/230) - eindeutig
  number        String   @unique
  // URL-sicherer Slug fuer /zertifikat/<slug> (Nummer mit / -> -)
  slug          String   @unique

  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  type          CertificateType
  status        CertificateStatus @default(DRAFT)

  // Snapshot der Daten zum Zeitpunkt der Erstellung (entkoppelt vom Event)
  data          String   // JSON: { firstName, lastName, company, eventTitle, eventDate, location, ... }

  // PDF-Hash fuer Integritaetscheck (optional)
  pdfHash       String?

  // Wenn vom Tool generiert: NULL. Wenn importiert: Pfad zum hochgeladenen Original.
  importedPath  String?

  issuedAt      DateTime?
  releasedAt    DateTime?
  revokedAt     DateTime?
  revokeReason  String?

  sentAt        DateTime?
  sentTo        String?

  createdById   String
  createdBy     User     @relation("CertCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([participantId])
  @@index([status])
}

model Comment {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  body          String   // verschluesselt
  createdAt     DateTime @default(now())
}

// Newsletter-Abonnent. E-Mail/Name verschluesselt (PII), Lookup ueber emailHash.
model NewsletterSubscriber {
  id             String   @id @default(cuid())
  email          String   // verschluesselt
  emailHash      String   @unique // HMAC-SHA-256 fuer Dedup/Lookup
  firstName      String?  // verschluesselt
  lastName       String?  // verschluesselt
  company        String?  // verschluesselt
  status         NewsletterStatus @default(PENDING)
  source         String   @default("manual") // cf7 | webhook | manual | import | <formname>
  tags           String?  // JSON-Array von Strings (Segmentierung)
  // Double-Opt-In / Abmeldung
  confirmToken     String?  @unique
  unsubscribeToken String   @unique
  consentAt        DateTime?  // Zeitpunkt der (Webhook-)Einwilligung
  confirmedAt      DateTime?  // Zeitpunkt der Double-Opt-In-Bestaetigung
  unsubscribedAt   DateTime?
  // DSGVO-Nachweis
  consentIp        String?
  consentSource    String?  // Roh-Info zur Herkunft (z.B. Formular-URL)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  emails EmailLog[]

  @@index([status])
  @@index([emailHash])
}

model Campaign {
  id          String   @id @default(cuid())
  subject     String
  bodyHtml    String   // HTML-Inhalt (Platzhalter erlaubt: {{firstName}}, {{unsubscribe}})
  bodyText    String?  // optionaler Text-Fallback
  status      CampaignStatus @default(DRAFT)
  // Segmentierung: leeres tagFilter = an alle SUBSCRIBED
  tagFilter   String?  // JSON-Array von Tags (mind. einer muss matchen)
  createdById String?
  sentAt      DateTime?
  recipientCount Int   @default(0)
  sentCount      Int   @default(0)
  failedCount    Int   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  emails EmailLog[]

  @@index([status])
}

model EmailLog {
  id           String   @id @default(cuid())
  toHash       String   // emailHash des Empfaengers (kein Klartext)
  subject      String
  kind         String   // TRANSACTIONAL | OPTIN | CAMPAIGN
  status       EmailStatus
  error        String?
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  subscriberId String?
  subscriber   NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([campaignId])
  @@index([toHash])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String   // CREATE | UPDATE | DELETE | LOGIN | GRANT | INVOICE_STATUS | ...
  entityType    String   // Participant | Event | User | EventAccess | Auth
  entityId      String?
  diff          String?  // JSON, ggf. verschluesselt bei PII
  createdAt     DateTime @default(now())

  @@index([participantId])
  @@index([actorId])
  @@index([createdAt])
}

// Pro Teilnehmer und Event ein Token-basierter Einladungs-Link zum Feedback.
// Aus Sicht des Teilnehmers ist das Feedback "anonym" beschriftet, technisch
// wissen wir aber, wer geantwortet hat (Token -> Invite -> Participant).
model FeedbackInvite {
  id            String   @id @default(cuid())
  token         String   @unique
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  response      FeedbackResponse?

  @@unique([eventId, participantId])
  @@index([eventId])
}

model FeedbackResponse {
  id          String   @id @default(cuid())
  inviteId    String   @unique
  invite      FeedbackInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  answers     String   // JSON
  submittedAt DateTime @default(now())
}

// OTP-Codes fuer das Teilnehmer-Portal /meine-zertifikate.
// Code wird per Mail an die hinterlegte Adresse geschickt; einmalig einlösbar.
model CertificateOtp {
  id        String   @id @default(cuid())
  emailHash String   // SHA-256-HMAC der E-Mail
  codeHash  String   // SHA-256 des 6-stelligen Codes
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([emailHash])
}
